/// 添加船只功能
async fn add_node_function(
    State(state): State<AppState>,
    Json(mut function): Json<NodeFunction>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    // 生成唯一ID
    function.id = Some(uuid::Uuid::new_v4().to_string());

    // 插入数据库
    sqlx::query(
        "INSERT INTO tb_node_function (id, name, type, code, remark, `on`) VALUES (?, ?, ?, ?, ?, ?)"
    )
    .bind(&function.id)
    .bind(&function.name)
    .bind(&function.function_type)
    .bind(&function.code)
    .bind(&function.remark)
    .bind(&function.is_on)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": function.id,
        "message": "添加成功",
    }))))
}

/// 更新船只功能
async fn update_node_function(
    State(state): State<AppState>,
    Json(function): Json<NodeFunction>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = function.id.clone()
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    sqlx::query(
        "UPDATE tb_node_function SET name = COALESCE(?, name), type = COALESCE(?, type), 
         code = COALESCE(?, code), remark = COALESCE(?, remark), `on` = COALESCE(?, `on`) WHERE id = ?"
    )
    .bind(&function.name)
    .bind(&function.function_type)
    .bind(&function.code)
    .bind(&function.remark)
    .bind(&function.is_on)
    .bind(&id)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "updated": true,
        "message": "修改成功",
    }))))
}

/// 删除船只功能
async fn delete_node_function(
    State(state): State<AppState>,
    Json(function): Json<NodeFunction>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = function.id.clone()
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 删除功能
    sqlx::query("DELETE FROM tb_node_function WHERE id = ?")
        .bind(&id)
        .execute(&state.db.pool)
        .await?;

    // 同时删除关联关系
    sqlx::query("DELETE FROM tb_node_and_function WHERE fid = ?")
        .bind(&id)
        .execute(&state.db.pool)
        .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "deleted": true,
        "message": "删除成功",
    }))))
}

/// 查询船只功能列表
async fn query_node_functions(
    State(state): State<AppState>,
    Json(function): Json<NodeFunction>,
) -> Result<Json<ApiResponse<Vec<NodeFunction>>>, AppError> {
    let mut query = String::from("SELECT id, name, type, code, remark, `on` FROM tb_node_function WHERE 1=1");
    let mut bind_values: Vec<String> = Vec::new();

    // 关键词搜索
    if let Some(keywords) = &function.keywords {
        if !keywords.is_empty() {
            query.push_str(" AND (name LIKE ? OR remark LIKE ?)");
            let pattern = format!("%{}%", keywords);
            bind_values.push(pattern.clone());
            bind_values.push(pattern);
        }
    }

    // 按类型筛选
    if let Some(function_type) = &function.function_type {
        if !function_type.is_empty() {
            query.push_str(" AND type = ?");
            bind_values.push(function_type.clone());
        }
    }

    // 按状态筛选
    if let Some(is_on) = &function.is_on {
        if !is_on.is_empty() {
            query.push_str(" AND `on` = ?");
            bind_values.push(is_on.clone());
        }
    }

    query.push_str(" ORDER BY id DESC");

    // 分页
    if let (Some(page), Some(limit)) = (function.page, function.limit) {
        if page > 0 && limit > 0 {
            let offset = (page - 1) * limit;
            query.push_str(&format!(" LIMIT {} OFFSET {}", limit, offset));
        }
    }

    // 执行查询
    let mut query_builder = sqlx::query_as::<_, (String, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>)>(&query);
    for value in &bind_values {
        query_builder = query_builder.bind(value);
    }

    let rows: Vec<(String, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>)> = 
        query_builder.fetch_all(&state.db.pool).await?;

    let functions: Vec<NodeFunction> = rows.iter().map(|r| {
        NodeFunction {
            id: Some(r.0.clone()),
            name: r.1.clone(),
            function_type: r.2.clone(),
            code: r.3.clone(),
            remark: r.4.clone(),
            is_on: r.5.clone(),
            page: None,
            limit: None,
            keywords: None,
            taskid: None,
        }
    }).collect();

    Ok(Json(ApiResponse::success(functions)))
}

/// 根据船只ID查询功能
async fn query_node_functions_by_node_id(
    State(state): State<AppState>,
    Json(node): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<Vec<NodeFunction>>>, AppError> {
    let node_id = node.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 查询与该船只关联的功能
    let rows: Vec<(String, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>)> = sqlx::query_as(
        "SELECT nf.id, nf.name, nf.type, nf.code, nf.remark, nf.`on` 
         FROM tb_node_function nf 
         INNER JOIN tb_node_and_function nf2 ON nf.id = nf2.fid 
         WHERE nf2.nid = ?"
    )
    .bind(node_id)
    .fetch_all(&state.db.pool)
    .await?;

    let functions: Vec<NodeFunction> = rows.iter().map(|r| {
        NodeFunction {
            id: Some(r.0.clone()),
            name: r.1.clone(),
            function_type: r.2.clone(),
            code: r.3.clone(),
            remark: r.4.clone(),
            is_on: r.5.clone(),
            page: None,
            limit: None,
            keywords: None,
            taskid: None,
        }
    }).collect();

    Ok(Json(ApiResponse::success(functions)))
}

/// 根据任务ID查询功能
async fn query_node_functions_by_task_id(
    State(state): State<AppState>,
    Json(function): Json<NodeFunction>,
) -> Result<Json<ApiResponse<Vec<NodeFunction>>>, AppError> {
    let task_id = function.taskid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少taskid参数".to_string()))?;

    // 根据任务ID查询船只，再查询船只的功能
    let rows: Vec<(String, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>)> = sqlx::query_as(
        "SELECT nf.id, nf.name, nf.type, nf.code, nf.remark, nf.`on` 
         FROM tb_node_function nf 
         INNER JOIN tb_node_and_function nf2 ON nf.id = nf2.fid 
         INNER JOIN tb_node n ON nf2.nid = n.id 
         WHERE n.taskid = ?"
    )
    .bind(&task_id)
    .fetch_all(&state.db.pool)
    .await?;

    let functions: Vec<NodeFunction> = rows.iter().map(|r| {
        NodeFunction {
            id: Some(r.0.clone()),
            name: r.1.clone(),
            function_type: r.2.clone(),
            code: r.3.clone(),
            remark: r.4.clone(),
            is_on: r.5.clone(),
            page: None,
            limit: None,
            keywords: None,
            taskid: None,
        }
    }).collect();

    Ok(Json(ApiResponse::success(functions)))
}

/// 添加船只功能关联
async fn add_node_function_binding(
    State(state): State<AppState>,
    Json(binding): Json<NodeFunAndNode>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = uuid::Uuid::new_v4().to_string();
    let nid = binding.nid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少nid参数".to_string()))?;
    let fid = binding.fid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少fid参数".to_string()))?;

    // 检查是否已存在关联
    let exists: bool = sqlx::query_scalar(
        "SELECT COUNT(*) > 0 FROM tb_node_and_function WHERE nid = ? AND fid = ?"
    )
    .bind(&nid)
    .bind(&fid)
    .fetch_one(&state.db.pool)
    .await?;

    if exists {
        return Ok(Json(ApiResponse::error(400, "关联关系已存在")));
    }

    // 插入关联关系
    sqlx::query(
        "INSERT INTO tb_node_and_function (id, nid, fid) VALUES (?, ?, ?)"
    )
    .bind(&id)
    .bind(&nid)
    .bind(&fid)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": id,
        "message": "绑定成功",
    }))))
}

/// 删除船只功能关联
async fn delete_node_function_binding(
    State(state): State<AppState>,
    Json(binding): Json<NodeFunAndNode>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let nid = binding.nid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少nid参数".to_string()))?;
    let fid = binding.fid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少fid参数".to_string()))?;

    // 删除关联关系
    let result = sqlx::query(
        "DELETE FROM tb_node_and_function WHERE nid = ? AND fid = ?"
    )
    .bind(&nid)
    .bind(&fid)
    .execute(&state.db.pool)
    .await?;

    if result.rows_affected() > 0 {
        Ok(Json(ApiResponse::success(serde_json::json!({
            "deleted": true,
            "message": "解绑成功",
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到关联关系")))
    }
}

