/// 应用状态
#[derive(Clone)]
pub struct AppState {
    pub db: Database,
    pub redis: Redis,
    pub jwt: JwtUtil,
    pub mongodb: Option<crate::mongodb::MongoDB>,
}

/// 创建路由
pub fn create_router(state: AppState) -> Router {
    Router::new()
        // 健康检查
        .route("/health", get(health_check))
        .route("/api/health", get(health_check))
        
        // MongoDB操作
        .route("/mango/find", get(mango_find))
        .route("/mango/findHistoricalData", get(mango_find_historical_data))
        .route("/mango/findNum", get(mango_find_num))
        .route("/mango/shell", post(mango_shell))
        
        // 认证相关
        .route("/auth/login", post(login))
        .route("/auth/register", post(register))
        .route("/register/verifyToken", get(verify_token))
        .route("/register/logout", post(logout))
        .route("/register/getPublicKey", get(get_public_key))
        
        // 用户相关
        .route("/user/list", get(list_users))
        .route("/user/add", post(add_user))
        .route("/user/update", put(update_user))
        .route("/user/delete", delete(delete_user))
        .route("/user/update/account/profile", put(update_user_profile))
        .route("/user/update/account/password", put(update_user_password))
        .route("/user/update/account/profileAndPasswrd", put(update_user_profile_and_password))
        .route("/user/queryUserByUserName", post(query_user_by_username))
        .route("/user/queryUserByUserNameX", post(query_user_detail_by_username))
        .route("/user/bindBoat", post(bind_boat))
        .route("/user/notBindboat", post(unbind_boat))
        .route("/user/addUserAndRoleAndParim", post(add_user_with_role_and_permission))
        .route("/user/bindCommonPermission", post(bind_common_permission))
        .route("/user/notBindCommonPermission", post(unbind_common_permission))
        .route("/user/updateAutAndOrgAndRoleAndNodeByUser", post(update_user_roles_and_nodes))
        
        // 船只高级查询
        .route("/node/queryAllByUserAndOrganization", get(query_nodes_by_user_and_organization))
        .route("/node/queryNodeAndFunctionByUserId", get(query_nodes_and_functions_by_user_id))
        .route("/node/queryOnlineDataByUser", get(query_online_nodes_by_user))
        .route("/node/queryNodeStatusByTcpport", post(query_node_status_by_tcp_port))
        
        // 权限管理
        .route("/permission/add", post(add_permission))
        .route("/permission/updatePermission", put(update_permission))
        .route("/permission/deletePermission", delete(delete_permission))
        .route("/permission/queryAll", post(query_all_permissions))
        
        // 模块管理
        .route("/module/add", post(add_module))
        .route("/module/updateModule", put(update_module))
        .route("/module/deleteModule", delete(delete_module))
        .route("/module/queryAll", post(query_all_modules))
        .route("/module/addModulePermission", post(add_module_permission))
        .route("/module/queryModulePermission", post(query_module_permissions))
        .route("/module/deleteModulePermission", delete(delete_module_permission))
        
        // 白名单管理
        .route("/whitelist/add", post(add_whitelist))
        .route("/whitelist/remove", post(remove_whitelist))
        .route("/whitelist/queryAll", get(query_all_whitelist))
        
        // 文件服务
        .route("/fileserver/upload/uploadLogo", post(upload_logo))
        .route("/fileserver/upload/uploadIco", post(upload_ico))
        .route("/fileserver/upload/uploadApp", post(upload_app))
        
        // 视频接口
        .route("/video/getVideoToken", post(get_video_token))
        
        // 地图观测计划
        .route("/mapObsPlan/polygonPoint", post(polygon_point))
        
        // APP管理
        .route("/app/addRecord", post(add_app_record))
        .route("/app/deleteRecord", post(delete_app_record))
        .route("/app/queryAll", post(query_all_app_records))
        .route("/app/queryNewVersion", post(query_latest_app_version))
        
        // 船只相关
        .route("/node/list", get(list_nodes))
        .route("/node/detail", get(get_node))
        .route("/node/add", post(add_node))
        .route("/node/update", put(update_node))
        .route("/node/delete", delete(delete_node))
        .route("/node/updateLocation", put(update_node_location))
        .route("/node/queryAll", get(list_nodes))  // 兼容旧接口
        
        // 船只参数相关
        .route("/node/parameter/list", get(list_node_parameters))
        .route("/node/parameter/update", post(update_node_parameter))
        .route("/node/parameter/queryAll", get(query_all_node_parameters))
        .route("/node/parameter/addParameter", post(add_node_parameter))
        .route("/node/parameter/updateParameter", put(update_node_parameter_full))
        .route("/node/parameter/deleteParameter", delete(delete_node_parameter_full))
        .route("/node/parameter/bindingParameterAndNode", post(bind_parameter_to_node))
        .route("/node/parameter/unbindParameterAndNode", post(unbind_parameter_from_node))
        
        // 用户船只关联
        .route("/user/node/list", get(list_user_nodes))
        
        // 区块任务相关
        .route("/blockPlan/list", get(list_block_plans))
        .route("/blockPlan/add", post(add_block_plan))
        .route("/blockPlan/update", put(update_block_plan))
        .route("/blockPlan/delete", delete(delete_block_plan))
        
        // 船坞任务相关
        .route("/mavlinkOperation/addDockyard", post(add_dockyard))
        .route("/mavlinkOperation/queryDockyard", get(query_dockyard))
        .route("/mavlinkOperation/querySingleDockyard", get(query_single_dockyard))
        .route("/mavlinkOperation/deleteDockyard", delete(delete_dockyard))
        .route("/mavlinkOperation/updateDockyard", put(update_dockyard))
        
        // 船只功能管理
        .route("/nodeFuncation/addNodeFuncation", post(add_node_function))
        .route("/nodeFuncation/updateNodeFuncation", put(update_node_function))
        .route("/nodeFuncation/deleteNodeFuncation", delete(delete_node_function))
        .route("/nodeFuncation/queryNodeFuncation", post(query_node_functions))
        .route("/nodeFuncation/queryNodeFuncationById", post(query_node_functions_by_node_id))
        .route("/nodeFuncation/queryNodeFuncationByTaskId", post(query_node_functions_by_task_id))
        .route("/nodeFuncation/addNodeFunAndNode", post(add_node_function_binding))
        .route("/nodeFuncation/deleteNodeFunAndNodeByNodeIdAndFunId", post(delete_node_function_binding))
        
        // 船只权限管理
        .route("/nodePermissions/addNodePermission", post(add_node_permission))
        .route("/nodePermissions/updateNodePermission", put(update_node_permission))
        .route("/nodePermissions/deleteNodePermission", delete(delete_node_permission))
        .route("/nodePermissions/queryNodePermissionsAll", post(query_node_permissions))
        .route("/nodePermissions/queryNodePermissionsByNodeId", post(query_node_permissions_by_node_id))
        .route("/nodePermissions/addNodePerAndNode", post(add_node_permission_binding))
        .route("/nodePermissions/deleteNodePerAndNodeByNodeIdAndPerId", post(delete_node_permission_binding))
        
        .with_state(state)
}

// ==================== 健康检查 ====================

async fn health_check() -> Json<serde_json::Value> {
    Json(serde_json::json!({
        "status": "ok",
        "service": "rust_hover",
        "version": "0.1.0"
    }))
}

// ==================== 认证相关 ====================

#[derive(Deserialize)]
pub struct LoginRequest {
    pub username: String,
    pub password: String,
}

#[derive(Serialize)]
pub struct LoginResponse {
    pub token: String,
    pub user_id: String,
    pub username: String,
}

async fn login(
    State(state): State<AppState>,
    Json(req): Json<LoginRequest>,
) -> Result<Json<LoginResponse>, AppError> {
    // 查询用户
    let user: (String, String, String) = sqlx::query_as(
        "SELECT id, username, password FROM tb_user WHERE username = ?"
    )
    .bind(&req.username)
    .fetch_optional(&state.db.pool)
    .await?
    .ok_or_else(|| AppError::Auth("用户不存在".to_string()))?;

    // 验证密码 (支持BCrypt和明文)
    let password_valid = if user.2.starts_with("$2") {
        // BCrypt格式的密码
        bcrypt::verify(&req.password, &user.2).unwrap_or(false)
    } else {
        // 明文密码（兼容旧数据）
        user.2 == req.password
    };
    
    if !password_valid {
        return Err(AppError::Auth("密码错误".to_string()));
    }

    // 生成Token
    let token = state.jwt.generate_token(&user.0, &user.1)
        .map_err(|e| AppError::Internal(anyhow::anyhow!("Token生成失败: {}", e)))?;

    Ok(Json(LoginResponse {
        token,
        user_id: user.0,
        username: user.1,
    }))
}

#[derive(Deserialize)]
pub struct RegisterRequest {
    pub username: String,
    pub password: String,
    pub nickname: Option<String>,
}

async fn register(
    State(state): State<AppState>,
    Json(req): Json<RegisterRequest>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    // 检查用户名是否已存在
    let exists: bool = sqlx::query_scalar(
        "SELECT COUNT(*) > 0 FROM tb_user WHERE username = ?"
    )
    .bind(&req.username)
    .fetch_one(&state.db.pool)
    .await?;

    if exists {
        return Err(AppError::BadRequest("用户名已存在".to_string()));
    }

    // 生成用户ID
    let user_id = uuid::Uuid::new_v4().to_string();

    // 插入用户
    sqlx::query(
        "INSERT INTO tb_user (id, username, password, nickname, created) VALUES (?, ?, ?, ?, NOW())"
    )
    .bind(&user_id)
    .bind(&req.username)
    .bind(&req.password)
    .bind(&req.nickname)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "user_id": user_id,
        "username": req.username,
    }))))
}

