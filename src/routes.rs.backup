/// 绑定设备
async fn bind_boat(
    State(state): State<AppState>,
    Json(binding): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let user_id = binding.get("userId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少userId参数".to_string()))?;
    let node_id = binding.get("nodeId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少nodeId参数".to_string()))?;

    // 检查是否已存在关联
    let exists: bool = sqlx::query_scalar(
        "SELECT COUNT(*) > 0 FROM tb_user_node WHERE userid = ? AND nodeid = ? AND (removecode IS NULL OR removecode = 1)"
    )
    .bind(user_id)
    .bind(node_id)
    .fetch_one(&state.db.pool)
    .await?;

    if exists {
        return Ok(Json(ApiResponse::error(400, "绑定关系已存在")));
    }

    // 插入关联关系
    let id = uuid::Uuid::new_v4().to_string();
    sqlx::query(
        "INSERT INTO tb_user_node (id, userid, nodeid, removecode) VALUES (?, ?, ?, 1)"
    )
    .bind(&id)
    .bind(user_id)
    .bind(node_id)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": id,
        "message": "绑定成功",
    }))))
}

/// 解除绑定设备
async fn unbind_boat(
    State(state): State<AppState>,
    Json(binding): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let user_id = binding.get("userId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少userId参数".to_string()))?;
    let node_id = binding.get("nodeId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少nodeId参数".to_string()))?;

    // 删除关联关系（软删除）
    let result = sqlx::query(
        "UPDATE tb_user_node SET removecode = 0 WHERE userid = ? AND nodeid = ?"
    )
    .bind(user_id)
    .bind(node_id)
    .execute(&state.db.pool)
    .await?;

    if result.rows_affected() > 0 {
        Ok(Json(ApiResponse::success(serde_json::json!({
            "deleted": true,
            "message": "解绑成功",
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到绑定关系")))
    }
}

// ==================== 船只高级查询 ====================

/// 根据用户和机构查询船只
async fn query_nodes_by_user_and_organization(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<Vec<serde_json::Value>>>, AppError> {
    let user_id = params.get("userId");
    let user_name = params.get("userName");
    let sname = params.get("sname");
    let node_id = params.get("id");

    if user_id.is_none() && user_name.is_none() {
        return Ok(Json(ApiResponse::error(400, "userId或userName不能为null")));
    }

    let mut query = String::from(
        "SELECT n.id, n.sname, n.ip, n.port, n.state, n.taskid, n.describes, n.tcpPort 
         FROM tb_node n 
         INNER JOIN tb_user_node un ON n.id = un.nodeid 
         WHERE 1=1 AND (un.removecode IS NULL OR un.removecode = 1)"
    );
    let mut bind_values: Vec<String> = Vec::new();

    // 根据用户ID或用户名筛选
    if let Some(uid) = user_id {
        if !uid.is_empty() {
            query.push_str(" AND un.userid = ?");
            bind_values.push(uid.clone());
        }
    } else if let Some(uname) = user_name {
        if !uname.is_empty() {
            // 先查询用户ID
            let user: Option<(String,)> = sqlx::query_as(
                "SELECT id FROM tb_user WHERE username = ?"
            )
            .bind(uname)
            .fetch_optional(&state.db.pool)
            .await?;
            
            if let Some(user) = user {
                query.push_str(" AND un.userid = ?");
                bind_values.push(user.0);
            } else {
                return Ok(Json(ApiResponse::success(Vec::new())));
            }
        }
    }

    // 船只名称筛选
    if let Some(sname) = sname {
        if !sname.is_empty() {
            query.push_str(" AND n.sname LIKE ?");
            bind_values.push(format!("%{}%", sname));
        }
    }

    // 船只ID筛选
    if let Some(nid) = node_id {
        if !nid.is_empty() {
            query.push_str(" AND n.id = ?");
            bind_values.push(nid.clone());
        }
    }

    query.push_str(" ORDER BY n.id DESC");

    // 执行查询
    let mut query_builder = sqlx::query_as::<_, (String, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>)>(&query);
    for value in &bind_values {
        query_builder = query_builder.bind(value);
    }

    let rows: Vec<(String, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>)> = 
        query_builder.fetch_all(&state.db.pool).await?;

    let nodes: Vec<serde_json::Value> = rows.iter().map(|r| {
        // 根据ID生成创建时间
        let create_time = if let Ok(timestamp) = r.0.parse::<i64>() {
            let datetime = chrono::DateTime::from_timestamp(timestamp / 1000, 0)
                .unwrap_or_default();
            datetime.format("%Y-%m-%d %H:%M:%S").to_string()
        } else {
            String::new()
        };

        serde_json::json!({
            "id": r.0,
            "sname": r.1,
            "ip": r.2,
            "port": r.3,
            "state": r.4,
            "taskid": r.5,
            "describes": r.6,
            "tcpPort": r.7,
            "createTime": create_time,
        })
    }).collect();

    Ok(Json(ApiResponse::success(nodes)))
}

/// 根据用户ID查询船只及功能权限
async fn query_nodes_and_functions_by_user_id(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<Vec<serde_json::Value>>>, AppError> {
    let user_id = params.get("userId");
    let user_name = params.get("userName");

    if user_id.is_none() && user_name.is_none() {
        return Ok(Json(ApiResponse::error(400, "userId或userName不能为null")));
    }

    let mut query = String::from(
        "SELECT n.id, n.sname, n.ip, n.port, n.state, n.taskid, n.describes, n.tcpPort,
                n.url, n.urlname, n.url2, n.urlname2, n.url3, n.urlname3
         FROM tb_node n 
         INNER JOIN tb_user_node un ON n.id = un.nodeid 
         WHERE 1=1 AND (un.removecode IS NULL OR un.removecode = 1)"
    );
    let mut bind_values: Vec<String> = Vec::new();

    // 根据用户ID或用户名筛选
    if let Some(uid) = user_id {
        if !uid.is_empty() {
            query.push_str(" AND un.userid = ?");
            bind_values.push(uid.clone());
        }
    } else if let Some(uname) = user_name {
        if !uname.is_empty() {
            let user: Option<(String,)> = sqlx::query_as(
                "SELECT id FROM tb_user WHERE username = ?"
            )
            .bind(uname)
            .fetch_optional(&state.db.pool)
            .await?;
            
            if let Some(user) = user {
                query.push_str(" AND un.userid = ?");
                bind_values.push(user.0);
            } else {
                return Ok(Json(ApiResponse::success(Vec::new())));
            }
        }
    }

    query.push_str(" ORDER BY n.id DESC");

    // 执行查询
    let mut query_builder = sqlx::query_as::<_, (
        String, Option<String>, Option<String>, Option<String>, Option<String>, 
        Option<String>, Option<String>, Option<String>,
        Option<String>, Option<String>, Option<String>, Option<String>, 
        Option<String>, Option<String>
    )>(&query);
    for value in &bind_values {
        query_builder = query_builder.bind(value);
    }

    let rows: Vec<(
        String, Option<String>, Option<String>, Option<String>, Option<String>, 
        Option<String>, Option<String>, Option<String>,
        Option<String>, Option<String>, Option<String>, Option<String>, 
        Option<String>, Option<String>
    )> = query_builder.fetch_all(&state.db.pool).await?;

    let mut nodes: Vec<serde_json::Value> = Vec::new();

    for r in &rows {
        let node_id = &r.0;
        
        // 查询船只功能
        let functions: Vec<(String, Option<String>, Option<String>, Option<String>)> = sqlx::query_as(
            "SELECT nf.id, nf.name, nf.type, nf.code 
             FROM tb_node_function nf 
             INNER JOIN tb_node_and_function nf2 ON nf.id = nf2.fid 
             WHERE nf2.nid = ?"
        )
        .bind(node_id)
        .fetch_all(&state.db.pool)
        .await?;

        // 查询船只权限
        let permissions: Vec<(String, Option<String>, Option<i32>, Option<String>)> = sqlx::query_as(
            "SELECT nj.id, nj.name, nj.code, nj.details 
             FROM tb_node_jurisdiction nj 
             INNER JOIN tb_node_and_jurisdiction nj2 ON nj.id = nj2.jurid 
             WHERE nj2.nodeid = ?"
        )
        .bind(node_id)
        .fetch_all(&state.db.pool)
        .await?;

        // 查询船只参数
        let parameters: Vec<(String, Option<String>)> = sqlx::query_as(
            "SELECT id, npid FROM tb_node_and_node_parameter WHERE nodeid = ?"
        )
        .bind(node_id)
        .fetch_all(&state.db.pool)
        .await?;

        // 格式化视频信息
        let mut video_list = Vec::new();
        if let Some(url) = &r.8 {
            if !url.is_empty() {
                video_list.push(serde_json::json!({
                    "url": url,
                    "urlname": r.9
                }));
            }
        }
        if let Some(url2) = &r.10 {
            if !url2.is_empty() {
                video_list.push(serde_json::json!({
                    "url": url2,
                    "urlname": r.11
                }));
            }
        }
        if let Some(url3) = &r.12 {
            if !url3.is_empty() {
                video_list.push(serde_json::json!({
                    "url": url3,
                    "urlname": r.13
                }));
            }
        }

        // 检查船只在线状态（从Redis获取）
        let online_state: bool = state.redis.exists(node_id).await.unwrap_or(false);

        // 根据ID生成创建时间
        let create_time = if let Ok(timestamp) = node_id.parse::<i64>() {
            let datetime = chrono::DateTime::from_timestamp(timestamp / 1000, 0)
                .unwrap_or_default();
            datetime.format("%Y-%m-%d %H:%M:%S").to_string()
        } else {
            String::new()
        };

        nodes.push(serde_json::json!({
            "id": node_id,
            "sname": r.1,
            "ip": r.2,
            "port": r.3,
            "state": if online_state { 1 } else { 0 },
            "taskid": r.5,
            "describes": r.6,
            "tcpPort": r.7,
            "video": video_list,
            "functions": functions.iter().map(|f| serde_json::json!({
                "id": f.0,
                "name": f.1,
                "type": f.2,
                "code": f.3,
            })).collect::<Vec<_>>(),
            "jurisdictions": permissions.iter().map(|p| serde_json::json!({
                "id": p.0,
                "name": p.1,
                "code": p.2,
                "details": p.3,
            })).collect::<Vec<_>>(),
            "nodeParameters": parameters.iter().map(|p| serde_json::json!({
                "id": p.0,
                "npid": p.1,
            })).collect::<Vec<_>>(),
            "createTime": create_time,
        }));
    }

    Ok(Json(ApiResponse::success(nodes)))
}

/// 查询用户在线船只
async fn query_online_nodes_by_user(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<Vec<serde_json::Value>>>, AppError> {
    let user_name = params.get("userName")
        .ok_or_else(|| AppError::BadRequest("缺少userName参数".to_string()))?;

    // 查询用户ID
    let user: Option<(String,)> = sqlx::query_as(
        "SELECT id FROM tb_user WHERE username = ?"
    )
    .bind(user_name)
    .fetch_optional(&state.db.pool)
    .await?;

    let user_id = match user {
        Some(u) => u.0,
        None => return Ok(Json(ApiResponse::success(Vec::new()))),
    };

    // 查询用户的所有船只
    let nodes: Vec<(String, Option<String>, Option<String>, Option<String>)> = sqlx::query_as(
        "SELECT n.id, n.sname, n.ip, n.port 
         FROM tb_node n 
         INNER JOIN tb_user_node un ON n.id = un.nodeid 
         WHERE un.userid = ? AND (un.removecode IS NULL OR un.removecode = 1)"
    )
    .bind(&user_id)
    .fetch_all(&state.db.pool)
    .await?;

    let mut online_nodes: Vec<serde_json::Value> = Vec::new();

    for node in &nodes {
        // 检查船只是否在线（从Redis获取数据）
        let online_data: Option<std::collections::HashMap<String, String>> = 
            state.redis.get(&node.0).await?
                .and_then(|data| serde_json::from_str(&data).ok());

        if let Some(data) = online_data {
            if !data.is_empty() {
                online_nodes.push(serde_json::json!({
                    "id": node.0,
                    "sname": node.1,
                    "ip": node.2,
                    "port": node.3,
                    "onlineData": data,
                }));
            }
        }
    }

    Ok(Json(ApiResponse::success(online_nodes)))
}

// ==================== 权限管理 ====================

/// 添加权限
async fn add_permission(
    State(state): State<AppState>,
    Json(mut permission): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = uuid::Uuid::new_v4().to_string();
    let mname = permission.get("mname").and_then(|v| v.as_str());
    let mdesc = permission.get("mdesc").and_then(|v| v.as_str());
    let uri = permission.get("uri").and_then(|v| v.as_str());
    let method = permission.get("method").and_then(|v| v.as_str());
    let parentid = permission.get("parentid").and_then(|v| v.as_str());

    sqlx::query(
        "INSERT INTO tb_permission (id, mname, mdesc, uri, method, parentid, removecode) 
         VALUES (?, ?, ?, ?, ?, ?, '1')"
    )
    .bind(&id)
    .bind(mname)
    .bind(mdesc)
    .bind(uri)
    .bind(method)
    .bind(parentid)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": id,
        "message": "添加成功",
    }))))
}

/// 更新权限
async fn update_permission(
    State(state): State<AppState>,
    Json(permission): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = permission.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;
    
    let mname = permission.get("mname").and_then(|v| v.as_str());
    let mdesc = permission.get("mdesc").and_then(|v| v.as_str());
    let uri = permission.get("uri").and_then(|v| v.as_str());
    let method = permission.get("method").and_then(|v| v.as_str());
    let parentid = permission.get("parentid").and_then(|v| v.as_str());

    sqlx::query(
        "UPDATE tb_permission SET 
         mname = COALESCE(?, mname), mdesc = COALESCE(?, mdesc),
         uri = COALESCE(?, uri), method = COALESCE(?, method),
         parentid = COALESCE(?, parentid) WHERE id = ?"
    )
    .bind(mname)
    .bind(mdesc)
    .bind(uri)
    .bind(method)
    .bind(parentid)
    .bind(id)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "updated": true,
        "message": "修改成功",
    }))))
}

/// 删除权限
async fn delete_permission(
    State(state): State<AppState>,
    Json(permission): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = permission.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 软删除
    sqlx::query("UPDATE tb_permission SET removecode = '0' WHERE id = ?")
        .bind(id)
        .execute(&state.db.pool)
        .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "deleted": true,
        "message": "删除成功",
    }))))
}

/// 查询所有权限
async fn query_all_permissions(
    State(state): State<AppState>,
    Json(permission): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<Vec<serde_json::Value>>>, AppError> {
    let mut query = String::from(
        "SELECT id, mname, mdesc, uri, method, parentid FROM tb_permission WHERE removecode = '1'"
    );
    let mut bind_values: Vec<String> = Vec::new();

    // 关键词搜索
    if let Some(keywords) = permission.get("keywords").and_then(|v| v.as_str()) {
        if !keywords.is_empty() {
            query.push_str(" AND (mname LIKE ? OR mdesc LIKE ?)");
            let pattern = format!("%{}%", keywords);
            bind_values.push(pattern.clone());
            bind_values.push(pattern);
        }
    }

    query.push_str(" ORDER BY id ASC");

    // 分页
    let page = permission.get("page").and_then(|v| v.as_i64()).unwrap_or(1);
    let limit = permission.get("limit").and_then(|v| v.as_i64()).unwrap_or(100);
    if page > 0 && limit > 0 {
        let offset = (page - 1) * limit;
        query.push_str(&format!(" LIMIT {} OFFSET {}", limit, offset));
    }

    // 执行查询
    let mut query_builder = sqlx::query_as::<_, (String, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>)>(&query);
    for value in &bind_values {
        query_builder = query_builder.bind(value);
    }

    let rows: Vec<(String, Option<String>, Option<String>, Option<String>, Option<String>, Option<String>)> = 
        query_builder.fetch_all(&state.db.pool).await?;

    let permissions: Vec<serde_json::Value> = rows.iter().map(|r| {
        serde_json::json!({
            "id": r.0,
            "mname": r.1,
            "mdesc": r.2,
            "uri": r.3,
            "method": r.4,
            "parentid": r.5,
        })
    }).collect();

    Ok(Json(ApiResponse::success(permissions)))
}

