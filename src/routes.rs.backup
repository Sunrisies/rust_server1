// ==================== 地图观测计划 ====================

/// 测绘点位渲染
async fn polygon_point(
    State(state): State<AppState>,
    Json(params): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    // 获取参数
    let boat_id = params.get("boatId").and_then(|v| v.as_str());
    let task_id = params.get("taskId").and_then(|v| v.as_str());
    
    // 查询区块任务
    let mut query = String::from("SELECT id, boat_id, task_name, polygon, route FROM block_plan WHERE 1=1");
    let mut bind_values: Vec<String> = Vec::new();
    
    if let Some(bid) = boat_id {
        if !bid.is_empty() {
            query.push_str(" AND boat_id = ?");
            bind_values.push(bid.to_string());
        }
    }
    
    if let Some(tid) = task_id {
        if !tid.is_empty() {
            query.push_str(" AND id = ?");
            bind_values.push(tid.to_string());
        }
    }
    
    query.push_str(" ORDER BY add_time DESC LIMIT 1");
    
    let mut query_builder = sqlx::query_as::<_, (String, Option<String>, Option<String>, Option<String>, Option<String>)>(&query);
    for value in &bind_values {
        query_builder = query_builder.bind(value);
    }
    
    let row: Option<(String, Option<String>, Option<String>, Option<String>, Option<String>)> = 
        query_builder.fetch_optional(&state.db.pool).await?;
    
    if let Some(r) = row {
        // 解析多边形数据
        let polygon: Option<Vec<Vec<f64>>> = r.3.and_then(|p| serde_json::from_str(&p).ok());
        let route: Option<Vec<Vec<f64>>> = r.4.and_then(|rt| serde_json::from_str(&rt).ok());
        
        Ok(Json(ApiResponse::success(serde_json::json!({
            "id": r.0,
            "boatId": r.1,
            "taskName": r.2,
            "polygon": polygon,
            "route": route,
        }))))
    } else {
        Ok(Json(ApiResponse::success(serde_json::json!({}))))
    }
}

// ==================== 认证高级功能（补充） ====================

/// 获取公钥（RSA公钥，用于前端加密密码）
async fn get_public_key(
    State(state): State<AppState>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    // 返回JWT密钥的前32位作为公钥（实际项目中应使用真正的RSA公钥）
    let public_key = &state.jwt.secret_key()[..32.min(state.jwt.secret_key().len())];
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "publicKey": public_key,
        "message": "获取公钥成功",
    }))))
}

// ==================== 用户高级功能（补充） ====================

/// 新增用户及角色、权限、机构、船只
async fn add_user_with_role_and_permission(
    State(state): State<AppState>,
    Json(data): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    // 获取用户信息
    let user = data.get("user")
        .ok_or_else(|| AppError::BadRequest("缺少user参数".to_string()))?;
    
    let username = user.get("username")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少username参数".to_string()))?;
    let password = user.get("password")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少password参数".to_string()))?;
    let nickname = user.get("nickname").and_then(|v| v.as_str());
    let phone = user.get("phone").and_then(|v| v.as_str());
    
    // 检查用户名是否已存在
    let exists: bool = sqlx::query_scalar(
        "SELECT COUNT(*) > 0 FROM tb_user WHERE username = ?"
    )
    .bind(username)
    .fetch_one(&state.db.pool)
    .await?;
    
    if exists {
        return Ok(Json(ApiResponse::error(400, "用户名已存在")));
    }
    
    // 创建用户
    let user_id = uuid::Uuid::new_v4().to_string();
    let hashed_password = bcrypt::hash(password, 4)
        .map_err(|e| AppError::Internal(anyhow::anyhow!("密码加密失败: {}", e)))?;
    
    sqlx::query(
        "INSERT INTO tb_user (id, username, password, nickname, phone, created, updated) 
         VALUES (?, ?, ?, ?, ?, NOW(), NOW())"
    )
    .bind(&user_id)
    .bind(username)
    .bind(&hashed_password)
    .bind(nickname)
    .bind(phone)
    .execute(&state.db.pool)
    .await?;
    
    // 添加角色关联
    if let Some(role_ids) = data.get("roleIds").and_then(|v| v.as_str()) {
        for role_id in role_ids.split(',') {
            let role_id = role_id.trim();
            if !role_id.is_empty() {
                let id = uuid::Uuid::new_v4().to_string();
                sqlx::query(
                    "INSERT INTO tb_user_role (id, userid, roleid, removecode) VALUES (?, ?, ?, '1')"
                )
                .bind(&id)
                .bind(&user_id)
                .bind(role_id)
                .execute(&state.db.pool)
                .await?;
            }
        }
    }
    
    // 添加船只关联
    if let Some(node_ids) = data.get("nodeIds").and_then(|v| v.as_str()) {
        for node_id in node_ids.split(',') {
            let node_id = node_id.trim();
            if !node_id.is_empty() {
                let id = uuid::Uuid::new_v4().to_string();
                sqlx::query(
                    "INSERT INTO tb_user_node (id, userid, nodeid, removecode) VALUES (?, ?, ?, 1)"
                )
                .bind(&id)
                .bind(&user_id)
                .bind(node_id)
                .execute(&state.db.pool)
                .await?;
            }
        }
    }
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "userId": user_id,
        "message": "用户创建成功",
    }))))
}

/// 绑定公共权限
async fn bind_common_permission(
    State(state): State<AppState>,
    Json(data): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let user_id = data.get("userId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少userId参数".to_string()))?;
    let permission_id = data.get("permissionId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少permissionId参数".to_string()))?;
    
    // 检查是否已存在
    let exists: bool = sqlx::query_scalar(
        "SELECT COUNT(*) > 0 FROM tb_user_and_cpermission WHERE uid = ? AND cpid = ?"
    )
    .bind(user_id)
    .bind(permission_id)
    .fetch_one(&state.db.pool)
    .await?;
    
    if exists {
        return Ok(Json(ApiResponse::error(400, "绑定关系已存在")));
    }
    
    let id = uuid::Uuid::new_v4().to_string();
    sqlx::query(
        "INSERT INTO tb_user_and_cpermission (id, uid, cpid) VALUES (?, ?, ?)"
    )
    .bind(&id)
    .bind(user_id)
    .bind(permission_id)
    .execute(&state.db.pool)
    .await?;
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": id,
        "message": "绑定成功",
    }))))
}

/// 解除绑定公共权限
async fn unbind_common_permission(
    State(state): State<AppState>,
    Json(data): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let user_id = data.get("userId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少userId参数".to_string()))?;
    let permission_id = data.get("permissionId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少permissionId参数".to_string()))?;
    
    let result = sqlx::query(
        "DELETE FROM tb_user_and_cpermission WHERE uid = ? AND cpid = ?"
    )
    .bind(user_id)
    .bind(permission_id)
    .execute(&state.db.pool)
    .await?;
    
    if result.rows_affected() > 0 {
        Ok(Json(ApiResponse::success(serde_json::json!({
            "deleted": true,
            "message": "解绑成功",
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到绑定关系")))
    }
}

/// 更新用户权限、机构、角色和船只
async fn update_user_roles_and_nodes(
    State(state): State<AppState>,
    Json(data): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let user = data.get("user")
        .ok_or_else(|| AppError::BadRequest("缺少user参数".to_string()))?;
    
    let user_id = user.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少用户id参数".to_string()))?;
    
    // 更新用户基本信息
    let username = user.get("username").and_then(|v| v.as_str());
    let nickname = user.get("nickname").and_then(|v| v.as_str());
    let phone = user.get("phone").and_then(|v| v.as_str());
    
    sqlx::query(
        "UPDATE tb_user SET username = COALESCE(?, username), nickname = COALESCE(?, nickname),
         phone = COALESCE(?, phone), updated = NOW() WHERE id = ?"
    )
    .bind(username)
    .bind(nickname)
    .bind(phone)
    .bind(user_id)
    .execute(&state.db.pool)
    .await?;
    
    // 删除原有角色关联
    sqlx::query("DELETE FROM tb_user_role WHERE userid = ?")
        .bind(user_id)
        .execute(&state.db.pool)
        .await?;
    
    // 添加新角色关联
    if let Some(role_ids) = data.get("roleIds").and_then(|v| v.as_str()) {
        for role_id in role_ids.split(',') {
            let role_id = role_id.trim();
            if !role_id.is_empty() {
                let id = uuid::Uuid::new_v4().to_string();
                sqlx::query(
                    "INSERT INTO tb_user_role (id, userid, roleid, removecode) VALUES (?, ?, ?, '1')"
                )
                .bind(&id)
                .bind(user_id)
                .bind(role_id)
                .execute(&state.db.pool)
                .await?;
            }
        }
    }
    
    // 删除原有船只关联
    sqlx::query("DELETE FROM tb_user_node WHERE userid = ?")
        .bind(user_id)
        .execute(&state.db.pool)
        .await?;
    
    // 添加新船只关联
    if let Some(node_ids) = data.get("nodeIds").and_then(|v| v.as_str()) {
        for node_id in node_ids.split(',') {
            let node_id = node_id.trim();
            if !node_id.is_empty() {
                let id = uuid::Uuid::new_v4().to_string();
                sqlx::query(
                    "INSERT INTO tb_user_node (id, userid, nodeid, removecode) VALUES (?, ?, ?, 1)"
                )
                .bind(&id)
                .bind(user_id)
                .bind(node_id)
                .execute(&state.db.pool)
                .await?;
            }
        }
    }
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "updated": true,
        "message": "更新成功",
    }))))
}

/// 更新用户资料和密码
async fn update_user_profile_and_password(
    State(state): State<AppState>,
    Json(user): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = user.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;
    
    // 更新用户资料
    let username = user.get("username").and_then(|v| v.as_str());
    let nickname = user.get("nickname").and_then(|v| v.as_str());
    let phone = user.get("phone").and_then(|v| v.as_str());
    let logo = user.get("logo").and_then(|v| v.as_str());
    
    sqlx::query(
        "UPDATE tb_user SET username = COALESCE(?, username), nickname = COALESCE(?, nickname),
         phone = COALESCE(?, phone), logo = COALESCE(?, logo), updated = NOW() WHERE id = ?"
    )
    .bind(username)
    .bind(nickname)
    .bind(phone)
    .bind(logo)
    .bind(id)
    .execute(&state.db.pool)
    .await?;
    
    // 更新密码（如果有）
    if let Some(password) = user.get("password").and_then(|v| v.as_str()) {
        if !password.is_empty() {
            let hashed_password = bcrypt::hash(password, 4)
                .map_err(|e| AppError::Internal(anyhow::anyhow!("密码加密失败: {}", e)))?;
            
            sqlx::query("UPDATE tb_user SET password = ? WHERE id = ?")
                .bind(&hashed_password)
                .bind(id)
                .execute(&state.db.pool)
                .await?;
        }
    }
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "updated": true,
        "message": "更新成功",
    }))))
}

/// 根据TCP端口查询船只状态
async fn query_node_status_by_tcp_port(
    State(state): State<AppState>,
    Json(data): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let port = data.get("tcpPort")
        .and_then(|v| v.as_i64())
        .ok_or_else(|| AppError::BadRequest("缺少tcpPort参数".to_string()))?;
    
    // 查询该端口对应的船只
    let node: Option<(String, Option<String>, Option<String>)> = sqlx::query_as(
        "SELECT id, sname, state FROM tb_node WHERE tcpPort = ?"
    )
    .bind(port.to_string())
    .fetch_optional(&state.db.pool)
    .await?;
    
    if let Some(n) = node {
        // 检查船只是否在线（从Redis获取）
        let online: bool = state.redis.exists(&n.0).await.unwrap_or(false);
        
        Ok(Json(ApiResponse::success(serde_json::json!({
            "nodeId": n.0,
            "sname": n.1,
            "tcpPort": port,
            "online": online,
            "state": if online { 1 } else { 0 },
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到该端口对应的船只")))
    }
}

// ==================== MongoDB操作（占位实现） ====================

/// MongoDB条件查询
async fn mango_find(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let mongodb = state.mongodb.as_ref()
        .ok_or_else(|| AppError::Internal(anyhow::anyhow!("MongoDB未配置")))?;
    
    // 构建查询条件
    let mut query = mongodb::bson::Document::new();
    let mut sort = Some(doc! { "time": 1 });
    let mut projection = None;
    let mut skip = None;
    let mut limit = None;
    
    // 支持的查询字段
    let fields = vec![
        "taskid", "heading_cd", "oxygen", "NH34", "X", "ox2", "nh5", "time", "nh4", 
        "lon", "nh1", "boatid", "lat", "battery_cv", "Depth", "ox5", "nh2", 
        "current_ca", "ph", "Y", "ox3", "taskname", "nh3", "speed_cms", "temperature",
        "cdv", "ox1", "Ctmd", "timestr", "ox4", "skip", "limit"
    ];
    
    for field in &fields {
        if let Some(value) = params.get(*field) {
            match *field {
                "skip" => {
                    skip = value.parse::<i64>().ok();
                }
                "limit" => {
                    limit = value.parse::<i64>().ok();
                }
                _ => {
                    // 处理特殊查询操作符
                    if value.starts_with("gte") {
                        let v = &value[3..];
                        query.insert(*field, doc! { "$gte": v });
                    } else if value.starts_with("gt") {
                        let v = &value[2..];
                        query.insert(*field, doc! { "$gt": v });
                    } else if value.starts_with("lte") {
                        let v = &value[3..];
                        query.insert(*field, doc! { "$lte": v });
                    } else if value.starts_with("lt") {
                        let v = &value[2..];
                        query.insert(*field, doc! { "$lt": v });
                    } else if value.starts_with("within") {
                        let v = &value[6..];
                        if let Some((min, max)) = v.split_once('-') {
                            if let (Ok(min_val), Ok(max_val)) = (min.parse::<i64>(), max.parse::<i64>()) {
                                query.insert(*field, doc! { "$gt": min_val, "$lt": max_val });
                            }
                        }
                    } else if value.starts_with('/') {
                        // 正则查询
                        let pattern = &value[1..];
                        query.insert(*field, doc! { "$regex": pattern, "$options": "i" });
                    } else {
                        query.insert(*field, value);
                    }
                }
            }
        }
    }
    
    // 指定返回字段
    if let Some(fields) = params.get("requestFields") {
        let mut proj = mongodb::bson::Document::new();
        for field in fields.split(',') {
            proj.insert(field.trim(), 1);
        }
        projection = Some(proj);
    }
    
    let results = mongodb.find(query, sort, projection, skip, limit).await
        .map_err(|e| AppError::Internal(anyhow::anyhow!("MongoDB查询失败: {}", e)))?;
    
    // 转换为JSON
    // 转换为JSON
    let json_results: Vec<serde_json::Value> = results.iter().filter_map(|doc| {
        // 手动转换BSON Document到JSON
        let mut json_obj = serde_json::Map::new();
        for (key, value) in doc.iter() {
            let json_value = match value {
                mongodb::bson::Bson::String(s) => serde_json::Value::String(s.clone()),
                mongodb::bson::Bson::Int32(i) => serde_json::json!(i),
                mongodb::bson::Bson::Int64(i) => serde_json::json!(i),
                mongodb::bson::Bson::Double(d) => serde_json::json!(d),
                mongodb::bson::Bson::Boolean(b) => serde_json::json!(b),
                mongodb::bson::Bson::Null => serde_json::Value::Null,
                _ => serde_json::Value::Null,
            };
            json_obj.insert(key.clone(), json_value);
        }
        Some(serde_json::Value::Object(json_obj))
    }).collect();
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "data": json_results,
        "count": json_results.len(),
    }))))
}

/// MongoDB查询历史数据
async fn mango_find_historical_data(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let mongodb = state.mongodb.as_ref()
        .ok_or_else(|| AppError::Internal(anyhow::anyhow!("MongoDB未配置")))?;
    
    // 构建查询条件
    let mut query = mongodb::bson::Document::new();
    let mut sort = Some(doc! { "time": 1 });
    let mut projection = None;
    let mut skip = None;
    let mut limit = None;
    
    // 支持的查询字段（包含历史数据特殊字段）
    let fields = vec![
        "datatype", "taskid", "heading_cd", "oxygen", "NH34", "X", "ox2", "nh5", 
        "time", "nh4", "lon", "nh1", "boatid", "lat", "battery_cv", "Depth", 
        "ox5", "nh2", "current_ca", "ph", "Y", "ox3", "taskname", "nh3", 
        "speed_cms", "temperature", "cdv", "ox1", "Ctmd", "timestr", "ox4", 
        "skip", "limit", "pointname", "routename"
    ];
    
    for field in &fields {
        if let Some(value) = params.get(*field) {
            match *field {
                "skip" => {
                    skip = value.parse::<i64>().ok();
                }
                "limit" => {
                    limit = value.parse::<i64>().ok();
                }
                "datatype" => {
                    // 处理数据类型
                    match value.as_str() {
                        "1" => { query.insert("type", "2"); }
                        "2" => { query.insert("type", "1"); }
                        "3" => {
                            query.insert("taskid", doc! { "$gt": "0" });
                            query.insert("reach", "1");
                        }
                        "999" => { /* 不过滤 */ }
                        _ => {}
                    }
                }
                _ => {
                    // 处理特殊查询操作符
                    if value.starts_with("gte") {
                        let v = &value[3..];
                        query.insert(*field, doc! { "$gte": v });
                    } else if value.starts_with("gt") {
                        let v = &value[2..];
                        query.insert(*field, doc! { "$gt": v });
                    } else if value.starts_with("lte") {
                        let v = &value[3..];
                        query.insert(*field, doc! { "$lte": v });
                    } else if value.starts_with("lt") {
                        let v = &value[2..];
                        query.insert(*field, doc! { "$lt": v });
                    } else if value.starts_with("within") {
                        let v = &value[6..];
                        if let Some((min, max)) = v.split_once('-') {
                            if let (Ok(min_val), Ok(max_val)) = (min.parse::<i64>(), max.parse::<i64>()) {
                                query.insert(*field, doc! { "$gt": min_val, "$lt": max_val });
                            }
                        }
                    } else if value.starts_with("/") {
                        // 正则查询
                        let pattern = &value[1..];
                        query.insert(*field, doc! { "$regex": pattern, "$options": "i" });
                    } else {
                        query.insert(*field, value);
                    }
                }
            }
        }
    }
    
    // 指定返回字段
    if let Some(fields) = params.get("requestFields") {
        let mut proj = mongodb::bson::Document::new();
        for field in fields.split(',') {
            proj.insert(field.trim(), 1);
        }
        projection = Some(proj);
    }
    
    let results = mongodb.find_historical_data(query, sort, projection, skip, limit).await
        .map_err(|e| AppError::Internal(anyhow::anyhow!("MongoDB查询失败: {}", e)))?;
    
    // 转换为JSON并移除_id字段
    let json_results: Vec<serde_json::Value> = results.iter().filter_map(|doc| {
        let mut json_obj = serde_json::Map::new();
        for (key, value) in doc.iter() {
            // 跳过_id字段
            if key == "_id" {
                continue;
            }
            let json_value = match value {
                mongodb::bson::Bson::String(s) => serde_json::Value::String(s.clone()),
                mongodb::bson::Bson::Int32(i) => serde_json::json!(i),
                mongodb::bson::Bson::Int64(i) => serde_json::json!(i),
                mongodb::bson::Bson::Double(d) => serde_json::json!(d),
                mongodb::bson::Bson::Boolean(b) => serde_json::json!(b),
                mongodb::bson::Bson::Null => serde_json::Value::Null,
                _ => serde_json::Value::Null,
            };
            json_obj.insert(key.clone(), json_value);
        }
        Some(serde_json::Value::Object(json_obj))
    }).collect();
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "data": json_results,
        "count": json_results.len(),
    }))))
}

/// MongoDB次数查询（查询不同的任务名）
async fn mango_find_num(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let mongodb = state.mongodb.as_ref()
        .ok_or_else(|| AppError::Internal(anyhow::anyhow!("MongoDB未配置")))?;
    
    // 构建查询条件
    let mut query = mongodb::bson::Document::new();
    
    // 支持的查询字段
    let fields = vec!["taskid", "boatid"];
    
    for field in &fields {
        if let Some(value) = params.get(*field) {
            query.insert(*field, value);
        }
    }
    
    let task_names = mongodb.find_task_names(query).await
        .map_err(|e| AppError::Internal(anyhow::anyhow!("MongoDB查询失败: {}", e)))?;
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "data": task_names,
    }))))
}

/// 执行重启脚本
async fn mango_shell() -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    // 执行重启脚本
    let output = std::process::Command::new("sh")
        .arg("-c")
        .arg("echo 'Script executed'")
        .output();
    
    match output {
        Ok(output) => {
            let stdout = String::from_utf8_lossy(&output.stdout).to_string();
            Ok(Json(ApiResponse::success(serde_json::json!({
                "result": "Success",
                "message": stdout,
            }))))
        }
        Err(e) => {
            Ok(Json(ApiResponse::success(serde_json::json!({
                "result": "Fail",
                "message": e.to_string(),
            }))))
        }
    }
}
