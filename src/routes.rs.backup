/// 添加模块权限关联
async fn add_module_permission(
    State(state): State<AppState>,
    Json(binding): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = uuid::Uuid::new_v4().to_string();
    let mid = binding.get("mid")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少mid参数".to_string()))?;
    let pid = binding.get("pid")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少pid参数".to_string()))?;

    // 检查是否已存在关联
    let exists: bool = sqlx::query_scalar(
        "SELECT COUNT(*) > 0 FROM tb_module_permission WHERE mid = ? AND pid = ?"
    )
    .bind(mid)
    .bind(pid)
    .fetch_one(&state.db.pool)
    .await?;

    if exists {
        return Ok(Json(ApiResponse::error(400, "关联关系已存在")));
    }

    sqlx::query(
        "INSERT INTO tb_module_permission (id, mid, pid) VALUES (?, ?, ?)"
    )
    .bind(&id)
    .bind(mid)
    .bind(pid)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": id,
        "message": "绑定成功",
    }))))
}

/// 查询模块权限
async fn query_module_permissions(
    State(state): State<AppState>,
    Json(binding): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<Vec<serde_json::Value>>>, AppError> {
    let mid = binding.get("mid")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少mid参数".to_string()))?;

    let permissions: Vec<(String, Option<String>, Option<String>, Option<String>, Option<String>)> = sqlx::query_as(
        "SELECT p.id, p.mname, p.mdesc, p.uri, p.method 
         FROM tb_permission p 
         INNER JOIN tb_module_permission mp ON p.id = mp.pid 
         WHERE mp.mid = ? AND p.removecode = '1'"
    )
    .bind(mid)
    .fetch_all(&state.db.pool)
    .await?;

    let result: Vec<serde_json::Value> = permissions.iter().map(|p| {
        serde_json::json!({
            "id": p.0,
            "mname": p.1,
            "mdesc": p.2,
            "uri": p.3,
            "method": p.4,
        })
    }).collect();

    Ok(Json(ApiResponse::success(result)))
}

/// 删除模块权限关联
async fn delete_module_permission(
    State(state): State<AppState>,
    Json(binding): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let mid = binding.get("mid")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少mid参数".to_string()))?;
    let pid = binding.get("pid")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少pid参数".to_string()))?;

    let result = sqlx::query(
        "DELETE FROM tb_module_permission WHERE mid = ? AND pid = ?"
    )
    .bind(mid)
    .bind(pid)
    .execute(&state.db.pool)
    .await?;

    if result.rows_affected() > 0 {
        Ok(Json(ApiResponse::success(serde_json::json!({
            "deleted": true,
            "message": "解绑成功",
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到关联关系")))
    }
}

// ==================== 白名单管理 ====================

/// 白名单Redis Key
const WHITELIST_KEY: &str = "IP_WHITELIST";

/// 添加白名单
async fn add_whitelist(
    State(state): State<AppState>,
    Json(whitelist): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let ip_address = whitelist.get("ipAddress")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少ipAddress参数".to_string()))?;
    
    if ip_address.is_empty() {
        return Ok(Json(ApiResponse::error(400, "IP地址不可为空")));
    }

    let name = whitelist.get("name").and_then(|v| v.as_str()).unwrap_or("");
    let username = whitelist.get("username").and_then(|v| v.as_str()).unwrap_or("");
    let token = whitelist.get("token").and_then(|v| v.as_str()).unwrap_or("");
    let desc = whitelist.get("desc").and_then(|v| v.as_str()).unwrap_or("");
    let create_time = chrono::Local::now().format("%Y-%m-%d %H:%M:%S").to_string();

    let whitelist_data = serde_json::json!({
        "ipAddress": ip_address,
        "name": name,
        "username": username,
        "token": token,
        "desc": desc,
        "createTime": create_time,
    });

    // 保存到Redis
    state.redis.set(
        &format!("{}:{}", WHITELIST_KEY, ip_address), 
        &whitelist_data.to_string()
    ).await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "message": "添加白名单成功",
    }))))
}

/// 移除白名单
async fn remove_whitelist(
    State(state): State<AppState>,
    Json(whitelist): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let ip_address = whitelist.get("ipAddress")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少ipAddress参数".to_string()))?;
    
    if ip_address.is_empty() {
        return Ok(Json(ApiResponse::error(400, "IP地址不可为空")));
    }

    // 从Redis删除
    state.redis.del(&format!("{}:{}", WHITELIST_KEY, ip_address)).await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "message": "移除白名单成功",
    }))))
}

/// 查询所有白名单
async fn query_all_whitelist(
    State(state): State<AppState>,
) -> Result<Json<ApiResponse<Vec<serde_json::Value>>>, AppError> {
    // 从Redis获取所有白名单
    // 注意：这里需要使用SCAN命令遍历，但为了简化，我们使用一个假设的列表
    // 实际项目中可能需要使用SCAN命令
    let mut whitelist: Vec<serde_json::Value> = Vec::new();
    
    // 尝试获取白名单列表（如果存在）
    if let Some(list_data) = state.redis.get(WHITELIST_KEY).await? {
        if let Ok(list) = serde_json::from_str::<Vec<String>>(&list_data) {
            for ip in list {
                if let Some(data) = state.redis.get(&format!("{}:{}", WHITELIST_KEY, &ip)).await? {
                    if let Ok(item) = serde_json::from_str::<serde_json::Value>(&data) {
                        whitelist.push(item);
                    }
                }
            }
        }
    }

    Ok(Json(ApiResponse::success(whitelist)))
}

// ==================== 认证高级功能 ====================

/// 验证Token是否有效
async fn verify_token(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let token = params.get("token")
        .ok_or_else(|| AppError::BadRequest("缺少token参数".to_string()))?;

    match state.jwt.validate_token(token) {
        Ok(claims) => {
            Ok(Json(ApiResponse::success(serde_json::json!({
                "valid": true,
                "userId": claims.sub,
                "username": claims.username,
                "expireTime": claims.exp,
            }))))
        }
        Err(_) => {
            Ok(Json(ApiResponse::success(serde_json::json!({
                "valid": false,
                "message": "Token无效或已过期",
            }))))
        }
    }
}

/// 退出登录（客户端删除Token即可）
async fn logout() -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    Ok(Json(ApiResponse::success(serde_json::json!({
        "message": "退出登录成功",
    }))))
}

