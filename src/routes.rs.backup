/// 更新船只权限
async fn update_node_permission(
    State(state): State<AppState>,
    Json(permission): Json<NodePermission>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = permission.id.clone()
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    sqlx::query(
        "UPDATE tb_node_jurisdiction SET name = COALESCE(?, name), code = COALESCE(?, code), 
         details = COALESCE(?, details) WHERE id = ?"
    )
    .bind(&permission.name)
    .bind(&permission.code)
    .bind(&permission.details)
    .bind(&id)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "updated": true,
        "message": "修改成功",
    }))))
}

/// 删除船只权限
async fn delete_node_permission(
    State(state): State<AppState>,
    Json(permission): Json<NodePermission>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = permission.id.clone()
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 删除权限
    sqlx::query("DELETE FROM tb_node_jurisdiction WHERE id = ?")
        .bind(&id)
        .execute(&state.db.pool)
        .await?;

    // 同时删除关联关系
    sqlx::query("DELETE FROM tb_node_and_jurisdiction WHERE jurid = ?")
        .bind(&id)
        .execute(&state.db.pool)
        .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "deleted": true,
        "message": "删除成功",
    }))))
}

/// 查询所有船只权限
async fn query_node_permissions(
    State(state): State<AppState>,
    Json(permission): Json<NodePermission>,
) -> Result<Json<ApiResponse<Vec<NodePermission>>>, AppError> {
    let mut query = String::from("SELECT id, name, code, details FROM tb_node_jurisdiction WHERE 1=1");
    let mut bind_values: Vec<String> = Vec::new();

    // 关键词搜索
    if let Some(keywords) = &permission.keywords {
        if !keywords.is_empty() {
            query.push_str(" AND (name LIKE ? OR details LIKE ?)");
            let pattern = format!("%{}%", keywords);
            bind_values.push(pattern.clone());
            bind_values.push(pattern);
        }
    }

    // 按code筛选
    if let Some(code) = permission.code {
        query.push_str(" AND code = ?");
        bind_values.push(code.to_string());
    }

    query.push_str(" ORDER BY id ASC");

    // 分页
    if let (Some(page), Some(limit)) = (permission.page, permission.limit) {
        if page > 0 && limit > 0 {
            let offset = (page - 1) * limit;
            query.push_str(&format!(" LIMIT {} OFFSET {}", limit, offset));
        }
    }

    // 执行查询
    let mut query_builder = sqlx::query_as::<_, (String, Option<String>, Option<i32>, Option<String>)>(&query);
    for value in &bind_values {
        query_builder = query_builder.bind(value);
    }

    let rows: Vec<(String, Option<String>, Option<i32>, Option<String>)> = 
        query_builder.fetch_all(&state.db.pool).await?;

    let permissions: Vec<NodePermission> = rows.iter().map(|r| {
        NodePermission {
            id: Some(r.0.clone()),
            name: r.1.clone(),
            code: r.2.clone(),
            details: r.3.clone(),
            page: None,
            limit: None,
            keywords: None,
        }
    }).collect();

    Ok(Json(ApiResponse::success(permissions)))
}

