/// 更新船只参数
async fn update_node_parameter_full(
    State(state): State<AppState>,
    Json(param): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = param.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;
    
    let name = param.get("name").and_then(|v| v.as_str());
    let code = param.get("code").and_then(|v| v.as_str());
    let hcode = param.get("hcode").and_then(|v| v.as_str());
    let unit = param.get("unit").and_then(|v| v.as_str());

    sqlx::query(
        "UPDATE tb_node_parameter SET 
         name = COALESCE(?, name), code = COALESCE(?, code),
         hcode = COALESCE(?, hcode), unit = COALESCE(?, unit) WHERE id = ?"
    )
    .bind(name)
    .bind(code)
    .bind(hcode)
    .bind(unit)
    .bind(id)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "updated": true,
        "message": "修改成功",
    }))))
}

/// 删除船只参数
async fn delete_node_parameter_full(
    State(state): State<AppState>,
    Json(param): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = param.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 删除参数
    sqlx::query("DELETE FROM tb_node_parameter WHERE id = ?")
        .bind(id)
        .execute(&state.db.pool)
        .await?;

    // 同时删除关联关系
    sqlx::query("DELETE FROM tb_node_and_node_parameter WHERE npid = ?")
        .bind(id)
        .execute(&state.db.pool)
        .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "deleted": true,
        "message": "删除成功",
    }))))
}

/// 绑定参数到船只
async fn bind_parameter_to_node(
    State(state): State<AppState>,
    Json(binding): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let node_id = binding.get("nodeId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少nodeId参数".to_string()))?;
    let np_id = binding.get("npId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少npId参数".to_string()))?;

    // 检查是否已存在关联
    let exists: bool = sqlx::query_scalar(
        "SELECT COUNT(*) > 0 FROM tb_node_and_node_parameter WHERE nodeid = ? AND npid = ?"
    )
    .bind(node_id)
    .bind(np_id)
    .fetch_one(&state.db.pool)
    .await?;

    if exists {
        return Ok(Json(ApiResponse::error(400, "绑定关系已存在")));
    }

    let id = uuid::Uuid::new_v4().to_string();
    sqlx::query(
        "INSERT INTO tb_node_and_node_parameter (id, nodeid, npid) VALUES (?, ?, ?)"
    )
    .bind(&id)
    .bind(node_id)
    .bind(np_id)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": id,
        "message": "绑定成功",
    }))))
}

/// 解绑船只参数
async fn unbind_parameter_from_node(
    State(state): State<AppState>,
    Json(binding): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let node_id = binding.get("nodeId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少nodeId参数".to_string()))?;
    let np_id = binding.get("npId")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少npId参数".to_string()))?;

    let result = sqlx::query(
        "DELETE FROM tb_node_and_node_parameter WHERE nodeid = ? AND npid = ?"
    )
    .bind(node_id)
    .bind(np_id)
    .execute(&state.db.pool)
    .await?;

    if result.rows_affected() > 0 {
        Ok(Json(ApiResponse::success(serde_json::json!({
            "deleted": true,
            "message": "解绑成功",
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到绑定关系")))
    }
}

// ==================== 文件服务 ====================

/// 上传Logo
async fn upload_logo(
    State(state): State<AppState>,
    mut multipart: axum::extract::Multipart,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    use futures_util::StreamExt;
    
    let mut file_name = String::new();
    let mut file_data: Vec<u8> = Vec::new();
    
    while let Some(field) = multipart.next_field().await.unwrap_or(None) {
        let name = field.name().unwrap_or("").to_string();
        if name == "file" {
            file_name = field.file_name().unwrap_or("").to_string();
            let data = field.bytes().await.unwrap_or_default();
            file_data = data.to_vec();
        }
    }
    
    if file_name.is_empty() {
        return Ok(Json(ApiResponse::error(400, "未选择文件")));
    }
    
    // 检查文件大小 (2MB限制)
    if file_data.len() > 2 * 1024 * 1024 {
        return Ok(Json(ApiResponse::error(400, "图片文件大小不得超过2M")));
    }
    
    // 检查文件类型
    let ext = file_name.split('.').last().unwrap_or("").to_lowercase();
    if !["jpg", "jpeg", "png", "gif"].contains(&ext.as_str()) {
        return Ok(Json(ApiResponse::error(400, "仅支持上传jpg、png、jpeg、gif格式的图片")));
    }
    
    // 生成文件路径
    let timestamp = chrono::Local::now().timestamp_millis();
    let upload_dir = format!("uploads/logo/{}", timestamp);
    std::fs::create_dir_all(&upload_dir).map_err(|e| {
        AppError::Internal(anyhow::anyhow!("创建目录失败: {}", e))
    })?;
    
    let file_path = format!("{}/{}", upload_dir, file_name);
    std::fs::write(&file_path, &file_data).map_err(|e| {
        AppError::Internal(anyhow::anyhow!("保存文件失败: {}", e))
    })?;
    
    let url = format!("/{}", file_path);
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": timestamp.to_string(),
        "type": "logo",
        "url": url,
        "message": "上传成功",
    }))))
}

