// ==================== APP管理 ====================

/// 添加APP记录
async fn add_app_record(
    State(state): State<AppState>,
    Json(app): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = uuid::Uuid::new_v4().to_string();
    let appdesc = app.get("appdesc").and_then(|v| v.as_str());
    let apptype = app.get("apptype").and_then(|v| v.as_str());
    let version = app.get("version").and_then(|v| v.as_str());
    let downloadurl = app.get("downloadurl").and_then(|v| v.as_str());

    sqlx::query(
        "INSERT INTO tb_app_record (id, appdesc, apptype, version, downloadurl, createtime, updatetime, removecode) 
         VALUES (?, ?, ?, ?, ?, NOW(), NOW(), '1')"
    )
    .bind(&id)
    .bind(appdesc)
    .bind(apptype)
    .bind(version)
    .bind(downloadurl)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": id,
        "message": "添加成功",
    }))))
}

/// 删除APP记录
async fn delete_app_record(
    State(state): State<AppState>,
    Json(app): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = app.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 软删除
    sqlx::query("UPDATE tb_app_record SET removecode = '0' WHERE id = ?")
        .bind(id)
        .execute(&state.db.pool)
        .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "deleted": true,
        "message": "删除成功",
    }))))
}

/// 查询所有APP记录
async fn query_all_app_records(
    State(state): State<AppState>,
    Json(app): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<Vec<serde_json::Value>>>, AppError> {
    let mut query = String::from(
        "SELECT id, appdesc, apptype, version, downloadurl, createtime, updatetime 
         FROM tb_app_record WHERE removecode = '1'"
    );
    let mut bind_values: Vec<String> = Vec::new();

    // 关键词搜索
    if let Some(keywords) = app.get("keywords").and_then(|v| v.as_str()) {
        if !keywords.is_empty() {
            query.push_str(" AND (appdesc LIKE ? OR apptype LIKE ?)");
            let pattern = format!("%{}%", keywords);
            bind_values.push(pattern.clone());
            bind_values.push(pattern);
        }
    }

    query.push_str(" ORDER BY createtime DESC");

    // 分页
    let page = app.get("page").and_then(|v| v.as_i64()).unwrap_or(1);
    let limit = app.get("limit").and_then(|v| v.as_i64()).unwrap_or(100);
    if page > 0 && limit > 0 {
        let offset = (page - 1) * limit;
        query.push_str(&format!(" LIMIT {} OFFSET {}", limit, offset));
    }

    let mut query_builder = sqlx::query_as::<_, (String, Option<String>, Option<String>, Option<String>, Option<String>, Option<chrono::NaiveDateTime>, Option<chrono::NaiveDateTime>)>(&query);
    for value in &bind_values {
        query_builder = query_builder.bind(value);
    }

    let rows: Vec<(String, Option<String>, Option<String>, Option<String>, Option<String>, Option<chrono::NaiveDateTime>, Option<chrono::NaiveDateTime>)> = 
        query_builder.fetch_all(&state.db.pool).await?;

    let records: Vec<serde_json::Value> = rows.iter().map(|r| {
        serde_json::json!({
            "id": r.0,
            "appdesc": r.1,
            "apptype": r.2,
            "version": r.3,
            "downloadurl": r.4,
            "createtime": r.5.map(|t| t.format("%Y-%m-%d %H:%M:%S").to_string()),
            "updatetime": r.6.map(|t| t.format("%Y-%m-%d %H:%M:%S").to_string()),
        })
    }).collect();

    Ok(Json(ApiResponse::success(records)))
}

/// 查询最新APP版本
async fn query_latest_app_version(
    State(state): State<AppState>,
    Json(app): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<Option<serde_json::Value>>>, AppError> {
    let apptype = app.get("apptype").and_then(|v| v.as_str());

    let mut query = String::from(
        "SELECT id, appdesc, apptype, version, downloadurl, createtime 
         FROM tb_app_record WHERE removecode = '1'"
    );
    let mut bind_values: Vec<String> = Vec::new();

    if let Some(ptype) = apptype {
        if !ptype.is_empty() {
            query.push_str(" AND apptype = ?");
            bind_values.push(ptype.to_string());
        }
    }

    query.push_str(" ORDER BY createtime DESC LIMIT 1");

    let mut query_builder = sqlx::query_as::<_, (String, Option<String>, Option<String>, Option<String>, Option<String>, Option<chrono::NaiveDateTime>)>(&query);
    for value in &bind_values {
        query_builder = query_builder.bind(value);
    }

    let row: Option<(String, Option<String>, Option<String>, Option<String>, Option<String>, Option<chrono::NaiveDateTime>)> = 
        query_builder.fetch_optional(&state.db.pool).await?;

    let record = row.map(|r| {
        serde_json::json!({
            "id": r.0,
            "appdesc": r.1,
            "apptype": r.2,
            "version": r.3,
            "downloadurl": r.4,
            "createtime": r.5.map(|t| t.format("%Y-%m-%d %H:%M:%S").to_string()),
        })
    });

    Ok(Json(ApiResponse::success(record)))
}

// ==================== 文件上传APP ====================

/// 上传APP
async fn upload_app(
    State(state): State<AppState>,
    mut multipart: axum::extract::Multipart,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    use futures_util::StreamExt;
    
    let mut file_name = String::new();
    let mut file_data: Vec<u8> = Vec::new();
    let mut app_type: Option<String> = None;
    
    while let Some(field) = multipart.next_field().await.unwrap_or(None) {
        let name = field.name().unwrap_or("").to_string();
        match name.as_str() {
            "file" => {
                file_name = field.file_name().unwrap_or("").to_string();
                let data = field.bytes().await.unwrap_or_default();
                file_data = data.to_vec();
            }
            "appType" => {
                let data = field.text().await.unwrap_or_default();
                app_type = Some(data);
            }
            _ => {}
        }
    }
    
    if file_name.is_empty() {
        return Ok(Json(ApiResponse::error(400, "未选择文件")));
    }
    
    // 生成文件路径
    let timestamp = chrono::Local::now().timestamp_millis();
    let upload_dir = format!("uploads/app/{}", timestamp);
    std::fs::create_dir_all(&upload_dir).map_err(|e| {
        AppError::Internal(anyhow::anyhow!("创建目录失败: {}", e))
    })?;
    
    let file_path = format!("{}/{}", upload_dir, file_name);
    std::fs::write(&file_path, &file_data).map_err(|e| {
        AppError::Internal(anyhow::anyhow!("保存文件失败: {}", e))
    })?;
    
    let url = format!("/{}", file_path);
    
    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": timestamp.to_string(),
        "type": "app",
        "appType": app_type,
        "url": url,
        "message": "上传成功",
    }))))
}

