    Ok(Json(ApiResponse::success(permissions)))
}

/// 添加船只权限关联
async fn add_node_permission_binding(
    State(state): State<AppState>,
    Json(binding): Json<NodeAndPermission>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = uuid::Uuid::new_v4().to_string();
    let nodeid = binding.nodeid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少nodeid参数".to_string()))?;
    let jurid = binding.jurid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少jurid参数".to_string()))?;

    // 检查是否已存在关联
    let exists: bool = sqlx::query_scalar(
        "SELECT COUNT(*) > 0 FROM tb_node_and_jurisdiction WHERE nodeid = ? AND jurid = ?"
    )
    .bind(&nodeid)
    .bind(&jurid)
    .fetch_one(&state.db.pool)
    .await?;

    if exists {
        return Ok(Json(ApiResponse::error(400, "关联关系已存在".to_string())));
    }

    // 插入关联关系
    sqlx::query(
        "INSERT INTO tb_node_and_jurisdiction (id, nodeid, jurid) VALUES (?, ?, ?)"
    )
    .bind(&id)
    .bind(&nodeid)
    .bind(&jurid)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": id,
        "message": "绑定成功",
    }))))
}

/// 删除船只权限关联
async fn delete_node_permission_binding(
    State(state): State<AppState>,
    Json(binding): Json<NodeAndPermission>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let nodeid = binding.nodeid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少nodeid参数".to_string()))?;
    let jurid = binding.jurid.clone()
        .ok_or_else(|| AppError::BadRequest("缺少jurid参数".to_string()))?;

    // 删除关联关系
    let result = sqlx::query(
        "DELETE FROM tb_node_and_jurisdiction WHERE nodeid = ? AND jurid = ?"
    )
    .bind(&nodeid)
    .bind(&jurid)
    .execute(&state.db.pool)
    .await?;

    if result.rows_affected() > 0 {
        Ok(Json(ApiResponse::success(serde_json::json!({
            "deleted": true,
            "message": "解绑成功",
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到关联关系".to_string())))
    }
}

// ==================== 用户高级功能 ====================

/// 更新用户资料
async fn update_user_profile(
    State(state): State<AppState>,
    Json(user): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = user.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;
    
    let username = user.get("username")
        .and_then(|v| v.as_str());
    let nickname = user.get("nickname")
        .and_then(|v| v.as_str());
    let phone = user.get("phone")
        .and_then(|v| v.as_str());
    let logo = user.get("logo")
        .and_then(|v| v.as_str());
    let remarks = user.get("remarks")
        .and_then(|v| v.as_str());

    // 检查用户名是否已被其他用户使用
    if let Some(username) = username {
        let existing_user: Option<(String,)> = sqlx::query_as(
            "SELECT id FROM tb_user WHERE username = ? AND id != ?"
        )
        .bind(username)
        .bind(id)
        .fetch_optional(&state.db.pool)
        .await?;
        
        if existing_user.is_some() {
            return Ok(Json(ApiResponse::error(400, "用户名已被其他用户使用")));
        }
    }

    sqlx::query(
        "UPDATE tb_user SET username = COALESCE(?, username), nickname = COALESCE(?, nickname), 
         phone = COALESCE(?, phone), logo = COALESCE(?, logo), remarks = COALESCE(?, remarks),
         updated = NOW() WHERE id = ?"
    )
    .bind(username)
    .bind(nickname)
    .bind(phone)
    .bind(logo)
    .bind(remarks)
    .bind(id)
    .execute(&state.db.pool)
    .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "updated": true,
        "message": "更新成功",
    }))))
}

/// 更新用户密码
async fn update_user_password(
    State(state): State<AppState>,
    Json(password_data): Json<serde_json::Value>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let id = password_data.get("id")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;
    
    let old_password = password_data.get("oldPassword")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少oldPassword参数".to_string()))?;
    
    let new_password = password_data.get("newPassword")
        .and_then(|v| v.as_str())
        .ok_or_else(|| AppError::BadRequest("缺少newPassword参数".to_string()))?;

    // 查询当前用户密码
    let user: Option<(String,)> = sqlx::query_as(
        "SELECT password FROM tb_user WHERE id = ?"
    )
    .bind(id)
    .fetch_optional(&state.db.pool)
    .await?;
    
    let user = user.ok_or_else(|| AppError::NotFound("用户不存在".to_string()))?;

    // 验证旧密码
    let password_valid = if user.0.starts_with("$2") {
        bcrypt::verify(old_password, &user.0).unwrap_or(false)
    } else {
        user.0 == old_password
    };

    if !password_valid {
        return Ok(Json(ApiResponse::error(400, "旧密码错误")));
    }

    // 加密新密码
    let hashed_password = bcrypt::hash(new_password, 4)
        .map_err(|e| AppError::Internal(anyhow::anyhow!("密码加密失败: {}", e)))?;

    // 更新密码
    sqlx::query("UPDATE tb_user SET password = ?, updated = NOW() WHERE id = ?")
        .bind(&hashed_password)
        .bind(id)
        .execute(&state.db.pool)
        .await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "updated": true,
        "message": "密码更新成功",
    }))))
}

