// ==================== 船坞任务相关 ====================

/// Redis中船坞任务的key前缀
const DOCKYARD_KEY: &str = "DOCKYAR_YEY_36";

async fn add_dockyard(
    State(state): State<AppState>,
    Json(mut dockyard): Json<DockyardNew>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    // 生成唯一ID
    dockyard.id = Some(uuid::Uuid::new_v4().to_string());
    dockyard.add_date = Some(chrono::Utc::now());
    dockyard.state = Some("1".to_string());

    // 获取船只ID
    let boat_id = dockyard.boat_id.clone()
        .ok_or_else(|| AppError::BadRequest("缺少boat_id参数".to_string()))?;

    // 从Redis获取该船只现有的任务列表
    let existing_tasks: Option<String> = state.redis.get(&format!("{}:{}", DOCKYARD_KEY, boat_id)).await?;
    let mut tasks: std::collections::HashMap<String, DockyardNew> = if let Some(data) = existing_tasks {
        serde_json::from_str(&data).unwrap_or_default()
    } else {
        std::collections::HashMap::new()
    };

    // 检查任务名是否已存在
    if let Some(name) = &dockyard.name {
        for task in tasks.values() {
            if let Some(existing_name) = &task.name {
                if existing_name == name {
                    return Ok(Json(ApiResponse::error(400, "任务名已存在，请重新设置名称")));
                }
            }
        }
    }

    // 添加新任务
    let task_id = dockyard.id.clone().unwrap();
    tasks.insert(task_id.clone(), dockyard.clone());

    // 保存到Redis
    let tasks_json = serde_json::to_string(&tasks)
        .map_err(|e| AppError::Internal(anyhow::anyhow!("序列化失败: {}", e)))?;
    state.redis.set(&format!("{}:{}", DOCKYARD_KEY, boat_id), &tasks_json).await?;

    Ok(Json(ApiResponse::success(serde_json::json!({
        "id": task_id,
        "message": "添加成功",
    }))))
}

async fn query_dockyard(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<Vec<DockyardNew>>>, AppError> {
    let boat_id = params.get("boatId")
        .ok_or_else(|| AppError::BadRequest("缺少boatId参数".to_string()))?;

    // 从Redis获取该船只的任务列表
    let existing_tasks: Option<String> = state.redis.get(&format!("{}:{}", DOCKYARD_KEY, boat_id)).await?;
    let tasks: std::collections::HashMap<String, DockyardNew> = if let Some(data) = existing_tasks {
        serde_json::from_str(&data).unwrap_or_default()
    } else {
        std::collections::HashMap::new()
    };

    // 转换为Vec并按更新时间倒序排列
    let mut task_list: Vec<DockyardNew> = tasks.into_values().collect();
    task_list.sort_by(|a, b| {
        match (&b.update_date, &a.update_date) {
            (Some(b_date), Some(a_date)) => b_date.cmp(a_date),
            (Some(_), None) => std::cmp::Ordering::Less,
            (None, Some(_)) => std::cmp::Ordering::Greater,
            (None, None) => {
                match (&b.add_date, &a.add_date) {
                    (Some(b_date), Some(a_date)) => b_date.cmp(a_date),
                    _ => std::cmp::Ordering::Equal,
                }
            }
        }
    });

    Ok(Json(ApiResponse::success(task_list)))
}

async fn query_single_dockyard(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<Vec<DockyardNew>>>, AppError> {
    let boat_id = params.get("boatId")
        .ok_or_else(|| AppError::BadRequest("缺少boatId参数".to_string()))?;
    let id = params.get("id")
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 从Redis获取该船只的任务列表
    let existing_tasks: Option<String> = state.redis.get(&format!("{}:{}", DOCKYARD_KEY, boat_id)).await?;
    let tasks: std::collections::HashMap<String, DockyardNew> = if let Some(data) = existing_tasks {
        serde_json::from_str(&data).unwrap_or_default()
    } else {
        std::collections::HashMap::new()
    };

    // 查找指定任务
    if let Some(task) = tasks.get(id) {
        Ok(Json(ApiResponse::success(vec![task.clone()])))
    } else {
        Ok(Json(ApiResponse::success(Vec::new())))
    }
}

async fn delete_dockyard(
    State(state): State<AppState>,
    axum::extract::Query(params): axum::extract::Query<std::collections::HashMap<String, String>>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let boat_id = params.get("boatId")
        .ok_or_else(|| AppError::BadRequest("缺少boatId参数".to_string()))?;
    let id = params.get("id")
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 从Redis获取该船只的任务列表
    let existing_tasks: Option<String> = state.redis.get(&format!("{}:{}", DOCKYARD_KEY, boat_id)).await?;
    let mut tasks: std::collections::HashMap<String, DockyardNew> = if let Some(data) = existing_tasks {
        serde_json::from_str(&data).unwrap_or_default()
    } else {
        std::collections::HashMap::new()
    };

    // 删除指定任务
    if let Some(removed_task) = tasks.remove(id) {
        // 保存到Redis
        let tasks_json = serde_json::to_string(&tasks)
            .map_err(|e| AppError::Internal(anyhow::anyhow!("序列化失败: {}", e)))?;
        state.redis.set(&format!("{}:{}", DOCKYARD_KEY, boat_id), &tasks_json).await?;

        Ok(Json(ApiResponse::success(serde_json::json!({
            "deleted": true,
            "task": removed_task,
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到指定任务")))
    }
}

async fn update_dockyard(
    State(state): State<AppState>,
    Json(dockyard): Json<DockyardNew>,
) -> Result<Json<ApiResponse<serde_json::Value>>, AppError> {
    let boat_id = dockyard.boat_id.clone()
        .ok_or_else(|| AppError::BadRequest("缺少boat_id参数".to_string()))?;
    let id = dockyard.id.clone()
        .ok_or_else(|| AppError::BadRequest("缺少id参数".to_string()))?;

    // 从Redis获取该船只的任务列表
    let existing_tasks: Option<String> = state.redis.get(&format!("{}:{}", DOCKYARD_KEY, boat_id)).await?;
    let mut tasks: std::collections::HashMap<String, DockyardNew> = if let Some(data) = existing_tasks {
        serde_json::from_str(&data).unwrap_or_default()
    } else {
        std::collections::HashMap::new()
    };

    // 检查任务名是否已存在（排除当前任务）
    if let Some(name) = &dockyard.name {
        for (task_id, task) in tasks.iter() {
            if task_id != &id {
                if let Some(existing_name) = &task.name {
                    if existing_name == name {
                        return Ok(Json(ApiResponse::error(400, "任务名已存在，请重新设置名称")));
                    }
                }
            }
        }
    }

    // 查找并更新任务
    if let Some(existing_task) = tasks.get_mut(&id) {
        // 更新任务字段
        existing_task.name = dockyard.name;
        existing_task.is_out = dockyard.is_out;
        existing_task.is_stop = dockyard.is_stop;
        existing_task.start_time = dockyard.start_time;
        existing_task.air_route = dockyard.air_route;
        existing_task.target_destination = dockyard.target_destination;
        existing_task.port = dockyard.port;
        existing_task.boat_name = dockyard.boat_name;
        existing_task.update_date = Some(chrono::Utc::now());
        existing_task.task_attribute = dockyard.task_attribute;

        // 如果任务失败，重置状态
        if existing_task.state.as_deref() == Some("5") {
            existing_task.error_cause = Some("".to_string());
            existing_task.state = Some("1".to_string());
        }

        // 保存到Redis
        let tasks_json = serde_json::to_string(&tasks)
            .map_err(|e| AppError::Internal(anyhow::anyhow!("序列化失败: {}", e)))?;
        state.redis.set(&format!("{}:{}", DOCKYARD_KEY, boat_id), &tasks_json).await?;

        Ok(Json(ApiResponse::success(serde_json::json!({
            "updated": true,
            "message": "修改成功",
        }))))
    } else {
        Ok(Json(ApiResponse::error(404, "未找到指定任务")))
    }
}

